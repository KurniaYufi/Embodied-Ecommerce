# Postgres connection. Locally: your own Postgres. On Vercel: added automatically by the Neon integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/embodied?schema=public"
# Direct (non-pooled) connection used by migrations. Locally: same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/embodied?schema=public"

# NextAuth — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob — added automatically when a Blob store is connected to the Vercel project.
# Leave empty locally: uploads are then saved to public/uploads.
# BLOB_READ_WRITE_TOKEN=""

# App
NEXT_PUBLIC_APP_NAME="Embodied"
